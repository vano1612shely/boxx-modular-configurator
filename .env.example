# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/configurator

# Payload
PAYLOAD_SECRET=change-me

# Public URL of the app (used for asset links inside the configurator)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Local only — `pnpm setup` creates this admin account on an empty database and
# skips it if either is unset. Never set these on a deployed instance.
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=change-me
