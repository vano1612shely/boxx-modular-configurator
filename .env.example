# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/configurator

# Payload
PAYLOAD_SECRET=change-me

# Public URL of the app (used for asset links inside the configurator)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Object storage — optional. Empty S3_BUCKET keeps uploads on local disk
# (./models, ./textures, ./images). Any S3-compatible store works.
S3_BUCKET=
# Required for non-AWS stores; omit for real AWS.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public read URL of the bucket or CDN. Empty = files are streamed through the app.
S3_PUBLIC_URL=
