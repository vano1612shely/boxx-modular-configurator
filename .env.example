# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/configurator

# Payload
PAYLOAD_SECRET=change-me

# Public URL of the app (used for asset links inside the configurator)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Object storage.
#
# Optional locally — leave S3_BUCKET empty and uploads go to ./models, ./textures
# and ./images on disk, which is fine for development.
#
# NOT optional in production. On a serverless host that disk is wiped between
# invocations, so every upload appears to succeed and is gone by the next
# request. Any S3-compatible store works; the values below are shaped for
# Supabase Storage, which also provides the Postgres this app needs, so one
# free account covers both halves of the stack.
S3_BUCKET=
# Supabase: https://<project_ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public read URL of the bucket. Supabase:
# https://<project_ref>.supabase.co/storage/v1/object/public/<bucket>
# Set it and the browser fetches uploads straight from the CDN; leave it empty
# and every file is streamed through a serverless function instead.
S3_PUBLIC_URL=
