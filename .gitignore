# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

/.idea/*
!/.idea/runConfigurations

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env

# Payload upload storage.
#
# These are the files visitors and admins uploaded, written to disk by the
# local-disk adapter — 55 MB of them already. They are DATA, not source: they
# belong in S3 (set S3_BUCKET and the adapter in payload.config.ts takes over),
# and on a serverless host the local disk is wiped between invocations anyway.
# Committing them would also bake that 55 MB into the history permanently.
/media
/models
/textures
/images

# Netlify
.netlify

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
